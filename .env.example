# Copy to .env (never commit .env). Secrets are NOT set here: they are files in secrets/ (mode 600, owner uid 10001):
#   secrets/opnsense_block.key   OPNsense API "key:secret" (or the downloaded apikey.txt) - blocking/policy reads
#   secrets/snmp_community       read-only SNMP community
#   secrets/webhook_hmac.key     optional webhook signing key
# The OpenAI key and per-firewall API keys entered in the UI are stored under data/secrets/ (mode 600).

# Address(es) Caddy serves the UI on, comma separated, e.g. "https://10.40.0.161, https://monitor.example.net"
NETMON_SITE=https://monitor.example.net

# Akvorado release the overlay in akvorado/ was tested with
AKVORADO_VERSION=v2026.10.1

# Optional: directory with Zeek JSON logs (<dir>/<sensor>/*.log); the source shows "awaiting" when absent
# NETMON_ZEEK_DIR=/var/log/zeek
